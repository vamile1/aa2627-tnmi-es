{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      "AGENTS.md": "ask",
      "opencode.json": "ask",
      ".opencode/**": "ask"
    },
    "webfetch": "allow",
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "wc *": "allow",
      "diff *": "allow",
      "mkdir *": "allow",
      "Get-ChildItem*": "allow",
      "Get-Content *": "allow",
      "Select-String *": "allow",
      "Test-Path *": "allow",
      "Get-Location": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git ls-files*": "allow",
      "git rev-parse*": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git remote get-url *": "allow",
      "git config user.name": "allow",
      "git config user.email": "allow",
      "git config --get *": "allow",
      "git add *": "allow",
      "git mv *": "allow",
      "git commit *": "allow",
      "git fetch*": "allow",
      "git pull": "allow",
      "git push": "allow",
      "git push origin main": "allow",
      "git push -u origin main": "allow"
    }
  }
}
